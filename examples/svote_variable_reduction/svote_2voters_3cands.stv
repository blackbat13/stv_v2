Agent Coercer:
LOCAL: [Coercer_cert1, Coercer_pun1, Coercer_dec1, Coercer_end1, Coercer_cert2, Coercer_pun2, Coercer_dec2, Coercer_end2]
PERSISTENT: [Coercer_cert1, Coercer_pun1, Coercer_dec1, Coercer_end1, Coercer_cert2, Coercer_pun2, Coercer_dec2, Coercer_end2]
INITIAL: []
init start
shared[2] Voter1_ng[Voter1_g]: start -> start [Coercer_cert1 := 0, Coercer_dec1 := 1]
shared[2] Voter1_gv1[Voter1_g]: start -> start [Coercer_cert1 := 1, Coercer_dec1 := 1]
shared[2] Voter1_gv2[Voter1_g]: start -> start [Coercer_cert1 := 1, Coercer_dec1 := 1]
shared[2] Voter1_gv3[Voter1_g]: start -> start [Coercer_cert1 := 1, Coercer_dec1 := 1]
np1: start [Coercer_dec1 == 1 && Coercer_end1 != 1] -> start [Coercer_pun1 := 0, Coercer_end1 := 1]
pun1: start [Coercer_dec1 == 1 && Coercer_end1 != 1] -> start [Coercer_pun1 := 1, Coercer_end1 := 1]
shared[2] Voter2_ng[Voter2_g]: start -> start [Coercer_cert2 := 0, Coercer_dec2 := 1]
shared[2] Voter2_gv1[Voter2_g]: start -> start [Coercer_cert2 := 1, Coercer_dec2 := 1]
shared[2] Voter2_gv2[Voter2_g]: start -> start [Coercer_cert2 := 1, Coercer_dec2 := 1]
shared[2] Voter2_gv3[Voter2_g]: start -> start [Coercer_cert2 := 1, Coercer_dec2 := 1]
np2: start [Coercer_dec2 == 1 && Coercer_end2 != 1] -> start [Coercer_pun2 := 0, Coercer_end2 := 1]
pun2: start [Coercer_dec2 == 1 && Coercer_end2 != 1] -> start [Coercer_pun2 := 1, Coercer_end2 := 1]
shared[3] idle[idle]: start [Coercer_end1 == 1 && Coercer_end2 == 1] -> start

FORMULA: <<Coercer>>[](Coercer_end1 == 0 || (Coercer_pun1 == 0 && Voter1_obeyed == 1) || (Coercer_pun1 == 5 && Voter1_disobeyed == 1))