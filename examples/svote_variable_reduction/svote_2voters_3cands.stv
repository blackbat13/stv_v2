Agent Voter1:
LOCAL: [Voter1_vote, Voter1_obeyed, Voter1_disobeyed]
PERSISTENT: [Voter1_vote, Voter1_obeyed, Voter1_disobeyed]
INITIAL: []
init start
vote1: start -> voted [Voter1_vote := 1]
shared[2] Voter1_gv1[Voter1_gv1]: voted [Voter1_vote == 1] -> obeyed [Voter1_obeyed := 1]
vote2: start -> voted [Voter1_vote := 2]
shared[2] Voter1_gv2[Voter1_gv2]: voted [Voter1_vote == 2] -> obeyed [Voter1_obeyed := 1]
vote3: start -> voted [Voter1_vote := 3]
shared[2] Voter1_gv3[Voter1_gv3]: voted [Voter1_vote == 3] -> obeyed [Voter1_obeyed := 1]
shared[2] Voter1_ng[Voter1_ng]: voted -> disobeyed [Voter1_disobeyed := 1]
shared[3] idle[idle]: obeyed -> obeyed
shared[3] idle[idle]: disobeyed -> disobeyed

Agent Voter2:
LOCAL: [Voter2_vote, Voter2_obeyed, Voter2_disobeyed]
PERSISTENT: [Voter2_vote, Voter2_obeyed, Voter2_disobeyed]
INITIAL: []
init start
vote1: start -> voted [Voter2_vote := 1]
shared[2] Voter2_gv1[Voter2_gv1]: voted [Voter2_vote == 1] -> obeyed [Voter2_obeyed := 1]
vote2: start -> voted [Voter2_vote := 2]
shared[2] Voter2_gv2[Voter2_gv2]: voted [Voter2_vote == 2] -> obeyed [Voter2_obeyed := 1]
vote3: start -> voted [Voter2_vote := 3]
shared[2] Voter2_gv3[Voter2_gv3]: voted [Voter2_vote == 3] -> obeyed [Voter2_obeyed := 1]
shared[2] Voter2_ng[Voter2_ng]: voted -> disobeyed [Voter2_disobeyed := 1]
shared[3] idle[idle]: obeyed -> obeyed
