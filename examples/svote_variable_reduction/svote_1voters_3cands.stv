Agent Voter1:
LOCAL: [Voter1_vote, Voter1_obeyed, Voter1_disobeyed]
PERSISTENT: [Voter1_vote, Voter1_obeyed, Voter1_disobeyed]
INITIAL: []
init start
vote1: start -> voted [Voter1_vote := 1]
shared[2] Voter1_gv1[Voter1_gv1]: voted [Voter1_vote == 1] -> obeyed [Voter1_obeyed := 1]
vote2: start -> voted [Voter1_vote := 2]
shared[2] Voter1_gv2[Voter1_gv2]: voted [Voter1_vote == 2] -> obeyed [Voter1_obeyed := 1]
vote3: start -> voted [Voter1_vote := 3]
shared[2] Voter1_gv3[Voter1_gv3]: voted [Voter1_vote == 3] -> obeyed [Voter1_obeyed := 1]
shared[2] Voter1_ng[Voter1_ng]: voted -> disobeyed [Voter1_disobeyed := 1]
shared[2] idle[idle]: obeyed -> obeyed
shared[2] idle[idle]: disobeyed -> disobeyed

Agent Coercer:
LOCAL: [Coercer_cert1, Coercer_pun1, Coercer_dec1, Coercer_end1]
PERSISTENT: [Coercer_cert1, Coercer_pun1, Coercer_dec1, Coercer_end1]
INITIAL: []
init start
shared[2] Voter1_ng[Voter1_g]: start -> start [Coercer_cert1 := 0, Coercer_dec1 := 1]
shared[2] Voter1_gv1[Voter1_g]: start -> start [Coercer_cert1 := 1, Coercer_dec1 := 1]
shared[2] Voter1_gv2[Voter1_g]: start -> start [Coercer_cert1 := 1, Coercer_dec1 := 1]
shared[2] Voter1_gv3[Voter1_g]: start -> start [Coercer_cert1 := 1, Coercer_dec1 := 1]
np1: start [Coercer_dec1 == 1 && Coercer_end1 != 1] -> start [Coercer_pun1 := 0, Coercer_end1 := 1]
pun1: start [Coercer_dec1 == 1 && Coercer_end1 != 1] -> start [Coercer_pun1 := 1, Coercer_end1 := 1]
shared[2] idle[idle]: start [Coercer_end1 == 1] -> start

FORMULA: <<Coercer>>[](Coercer_end1 == 0 || ((Coercer_pun1 == 0 && Voter1_obeyed == 1) || (Coercer_pun1 == 1 && Voter1_disobeyed == 1)))