Agent Voter1:
LOCAL: [Voter1_disobeyed, Voter1_obeyed]
PERSISTENT: [Voter1_disobeyed, Voter1_obeyed]
INITIAL: []
init start
vote1: start -> voted
vote2: start -> voted
vote3: start -> voted
shared[2] Voter1_gv1[Voter1_gv1]: voted -> obeyed [Voter1_obeyed:=1]
shared[2] Voter1_ng[Voter1_ng]: voted -> disobeyed [Voter1_disobeyed:=1]
shared[2] Voter1_gv2[Voter1_gv2]: voted -> obeyed [Voter1_obeyed:=1]
shared[2] Voter1_gv3[Voter1_gv3]: voted -> obeyed [Voter1_obeyed:=1]
shared[4] idle[idle]: obeyed -> obeyed
shared[4] idle[idle]: disobeyed -> disobeyed

