Agent Voter1:
LOCAL: [Voter1_disobeyed, Voter1_obeyed]
PERSISTENT: [Voter1_disobeyed, Voter1_obeyed]
INITIAL: []
init start
vote1: start -> voted
vote2: start -> voted
vote3: start -> voted
shared[2] Voter1_gv1[Voter1_gv1]: voted -> obeyed [Voter1_obeyed:=1]
shared[2] Voter1_ng[Voter1_ng]: voted -> disobeyed [Voter1_disobeyed:=1]
shared[2] Voter1_gv2[Voter1_gv2]: voted -> obeyed [Voter1_obeyed:=1]
shared[2] Voter1_gv3[Voter1_gv3]: voted -> obeyed [Voter1_obeyed:=1]
shared[3] idle[idle]: obeyed -> obeyed
shared[3] idle[idle]: disobeyed -> disobeyed

Agent Voter2:
LOCAL: []
PERSISTENT: []
INITIAL: []
init start
vote1: start -> voted
vote2: start -> voted
vote3: start -> voted
shared[2] Voter2_gv1[Voter2_gv1]: voted -> obeyed
shared[2] Voter2_ng[Voter2_ng]: voted -> disobeyed
shared[2] Voter2_gv2[Voter2_gv2]: voted -> obeyed
